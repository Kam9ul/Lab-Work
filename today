#include <stdio.h>

int main()
{
    int n, at[10], bt[10], wt[10], tat[10];
    int avwt = 0, avtat = 0, i;

    printf("Enter the Number of Process:\n");
    scanf("%d", &n);

    printf("Enter Process Burst Time:\n");

    for(i = 0; i < n; i++)
    {
        printf("P[%d] Arrival Time: ", i);
        scanf("%d", &at[i]);

        printf("P[%d] Burst Time: ", i);
        scanf("%d", &bt[i]);
    }

    // Waiting Time
    wt[0] = 0;

    for(i = 1; i < n; i++)
    {
        wt[i] = wt[i-1] + bt[i-1] - (at[i] - at[i-1]);

        if(wt[i] < 0)
            wt[i] = 0;
    }

    printf("\nProcess\tArrival Time\tBurst Time\tWaiting Time\tTurn Around Time");

    for(i = 0; i < n; i++)
    {
        tat[i] = wt[i] + bt[i];

        avwt = avwt + wt[i];
        avtat = avtat + tat[i];

        printf("\nP[%d]\t%d\t\t%d\t\t%d\t\t%d",
               i, at[i], bt[i], wt[i], tat[i]);
    }

    avwt = avwt / n;
    avtat = avtat / n;

    printf("\n\nAverage Waiting Time: %d", avwt);
    printf("\nAverage Turn Around Time: %d", avtat);

    return 0;
}