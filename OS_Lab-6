#include<stdio.h>
int main()
{
    int n,at[10],bt[10],wt[10],tat[10],avwt=0,avtat=0,i,j;

    printf("Enter the Number of Process:\n");
    scanf("%d",&n);

    printf("Enter Process Burst Time:\n");
    for(i=0;i<n;i++)
    {

        printf("P[%d] Arrival Time: ", i);
        scanf("%d", &at[i]);
        printf("P[%d] Burst Time: ", i);
        scanf("%d", &bt[i]);
    }
    wt[0]=0;
    for(i=1;i<n;i++)
    {
        wt[i]=0;
        for(j=0;j<i;j++)
            wt[i]=at[i]+bt[j];
    }

    printf("\n Process\t Arrival Time\t Burst Time\t Wating Time\t Turn Arround Time");
    for(i=0;i<n;i++);
    {

    tat[i]=wt[i]+bt[i];
    avwt=avwt= wt[i];
    avtat=avtat+tat[i];
    printf("\nP[%d]\t\t%d\t\t%d\t\t%d\t\t%d",i, at[i], bt[i], wt[i], tat[i]);
}

avwt=avwt/n;
avtat=avtat/n;
printf("\nAveage Waiting Time: %d,avwt");
printf("\nAveage Turn Arround Time: %d,avtat");
return 0;
}
